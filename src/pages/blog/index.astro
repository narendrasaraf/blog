---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReadingTime } from '../../utils/readingTime';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Articles — Narendra Saraf"
  description="All research articles and engineering essays published on blog.narendrasaraf.in."
>
  <section class="hero-home">
    <div class="container">
      <h1>All Articles</h1>
      <p>Research walkthroughs, architecture breakdowns, and engineering notes.</p>
    </div>
  </section>

  <section class="posts-section">
    <div class="container">
      <div class="post-grid">
        {posts.map((post) => {
          const readingTime = getReadingTime(post.body ?? '');
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <article class="post-card">
              {post.data.coverImage && (
                <a href={`/blog/${post.id}/`}>
                  <img
                    class="post-card-cover"
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt ?? post.data.title}
                    loading="lazy"
                  />
                </a>
              )}
              <div class="post-card-body">
                <div class="post-card-meta">
                  <span>{post.data.category}</span>
                  <span>&middot;</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                  <span>&middot;</span>
                  <span>{readingTime} min read</span>
                </div>
                <h2 class="post-card-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="post-card-desc">{post.data.description}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
