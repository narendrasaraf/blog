---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReadingTime } from '../utils/readingTime';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Narendra Saraf — Engineering & AI Research Blog"
  description="Technical writing and research notes on NLP, affective computing, machine learning systems, and intelligent software by Narendra Saraf."
>
  <section class="hero-home">
    <div class="container">
      <div class="hero-top-row">
        <span class="badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>Engineering &amp; Research</span>
        </span>

        <a href="https://narendrasaraf.in" class="portfolio-back-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 14 4 9l5-5" />
            <path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11" />
          </svg>
          <span>Go to Portfolio</span>
        </a>
      </div>

      <h1>Notes on AI Systems, NLP &amp; Applied Research</h1>
      <p>
        Deep dives into machine learning architectures, affective computing, and systems engineering—written from first principles.
      </p>
    </div>
  </section>

  <section class="posts-section">
    <div class="container">
      <h2 class="section-heading">Latest Publications</h2>
      <div class="post-grid">
        {posts.map((post) => {
          const readingTime = getReadingTime(post.body ?? '');
          const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          });
          return (
            <article class="post-card">
              {post.data.coverImage && (
                <a href={`/blog/${post.id}/`}>
                  <img
                    class="post-card-cover"
                    src={post.data.coverImage}
                    alt={post.data.coverImageAlt ?? post.data.title}
                    loading="lazy"
                  />
                </a>
              )}
              <div class="post-card-body">
                <div class="post-card-meta">
                  <span>{post.data.category}</span>
                  <span>&middot;</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
                  <span>&middot;</span>
                  <span>{readingTime} min read</span>
                </div>
                <h3 class="post-card-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p class="post-card-desc">{post.data.description}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>
